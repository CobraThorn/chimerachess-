# Frontend (Vite) — optional; leave unset for same-origin /api/chimera (Netlify/Vite proxy).
# VITE_CHIMERA_API_URL=https://chimerachess-0so2.onrender.com
# Use the Render host origin only — do not append /api/chimera.

# Do NOT put OpenAI keys in VITE_* — they would ship in the client bundle.
# Use CHIMERA_OPENAI_API_KEY on the server (see below).

# --- Server only (Railway / Render dashboard) ---
# PORT is set automatically by the host

# Persist data on a mounted volume (Railway)
# CHIMERA_DATA_DIR=/app/server/data

# CORS: comma-separated origins (required if the browser calls Render directly).
# Netlify same-origin proxy (/api/chimera) does not need CORS for the main app.
# CHIMERA_CORS_ORIGIN=https://chimerachess.co.uk,https://www.chimerachess.co.uk

# Server-side GPT coach (never exposed to the browser)
# CHIMERA_OPENAI_API_KEY=sk-...

# Admin wipe endpoint
# CHIMERA_ADMIN_SECRET=...
