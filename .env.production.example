# Netlify: leave VITE_CHIMERA_API_URL unset — netlify.toml proxies /api/chimera to Render.
# Only set when the browser must call Render directly (enable CHIMERA_CORS_ORIGIN on Render):
# VITE_CHIMERA_API_URL=https://chimerachess-0so2.onrender.com
# VITE_OPENAI_API_KEY=sk-...

# Render / Railway (server only — not Vite):
# CHIMERA_CORS_ORIGIN=https://chimerachess.co.uk
# CHIMERA_DATA_DIR=/app/server/data
